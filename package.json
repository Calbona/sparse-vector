{
  "name": "sparse-vector",
  "version": "1.0.0",
  "description": "A sparse vector library for TypeScript, providing compact data structures and essential operations.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && node --test \"test/*.test.mts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sparse",
    "vector",
    "sparse-vector",
    "data-structure",
    "typescript"
  ],
  "author": "Calbona",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Calbona/sparse-vector.git"
  },
  "homepage": "https://github.com/Calbona/sparse-vector#readme",
  "bugs": {
    "url": "https://github.com/Calbona/sparse-vector/issues"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
